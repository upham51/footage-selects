{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Footage Selects",
  "version": "0.2.3",
  "identifier": "com.footageselects.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 1360,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 680,
        "dragDropEnabled": true,
        "backgroundColor": "#0F1621"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/upham51/footage-selects/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "Video",
    "shortDescription": "Pulls selects from raw footage",
    "longDescription": "Scores every clip for focus, exposure and camera stability using classical image math, picks the best moments, and exports a timeline for DaVinci Resolve, Premiere Pro and Final Cut Pro. It works fully offline.",
    "copyright": "Copyright 2026. All rights reserved. Includes FFmpeg under the GNU LGPL 2.1; see THIRD_PARTY_LICENSES.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD_PARTY_LICENSES": "THIRD_PARTY_LICENSES.txt",
      "ffmpeg-build-info.txt": "ffmpeg-build-info.txt"
    },
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
